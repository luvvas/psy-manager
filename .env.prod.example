# Template do arquivo de ambiente de produção.
#
# O conteúdo completo (preenchido) vai no secret PROD_ENV_FILE do environment
# `production` no GitHub. O workflow de deploy grava ele na VPS como
# ~/psy-manager/.env.prod (modo 600). Nunca commite o arquivo preenchido.
#
# Valores com espaço precisam de aspas (o arquivo é lido pelo Docker Compose e
# pelo bash do backup-db.sh).

# --- Banco ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                        # openssl rand -base64 32
POSTGRES_DB=psy_manager
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/psy_manager

# --- Auth / URLs (mesmo domínio para SPA e API) ---
BETTER_AUTH_URL=https://app.seudominio.com.br
BETTER_AUTH_SECRET=                       # openssl rand -base64 32
PUBLIC_URL=https://app.seudominio.com.br
ALLOWED_ORIGINS=https://app.seudominio.com.br
ENCRYPTION_KEY=                           # mesma chave de hoje (senão os dados não decriptam)

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.seudominio.com.br/google-callback

# --- Documentos: Cloudflare R2 (token com escopo só no bucket de documentos) ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=psy-manager-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Backups: R2 (token separado, escopo só no bucket de backups) ---
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=psy-manager-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=                     # opcional: chave pública age (age1...)

# --- Cloudflare ---
CF_TURN_KEY_ID=                           # Realtime > TURN
CF_TURN_API_TOKEN=

# --- Observabilidade / e-mail / integrações ---
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="psy-manager <noreply@seudominio.com.br>"
DISCORD_FEEDBACK_WEBHOOK_URL=
