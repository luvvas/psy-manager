# ============================================
# Web Dockerfile — nginx servindo o build do Vite
# ============================================
#
# O build do frontend acontece no CI (job build-frontend), que tem os segredos
# do Sentry. Esta imagem só empacota o resultado. O contexto do build NÃO é a
# raiz do repo (o .dockerignore de lá exclui dist/ e docker/): o CI monta um
# diretório com `dist/` e `nginx.conf` e usa ele como contexto.

FROM nginx:1.30-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
EXPOSE 80
