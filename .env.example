# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/psy_manager
POSTGRES_USER=postgres
# "postgres" só serve para dev local (porta presa em 127.0.0.1); em produção a API recusa.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=psy_manager

# API
API_PORT=3001
BETTER_AUTH_URL=http://localhost:3001
# Obrigatória (a API não inicia sem ela); pelo menos 32 caracteres.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Document storage
# local = grava PDFs em apps/api/.storage durante desenvolvimento
# s3 = usa URLs pre-assinadas para enviar PDFs direto a um bucket privado
#      compativel com S3 (em producao: Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
S3_ENDPOINT=                 # R2: https://<account-id>.r2.cloudflarestorage.com (vazio = AWS S3)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web
VITE_API_URL=http://localhost:3001

# Video call — public URL used to build patient magic links (set to the frontend origin in prod)
PUBLIC_URL=http://localhost:5173

# Video call — Cloudflare Realtime TURN for clients behind strict NAT/CGNAT
# (optional, falls back to STUN only). Create a TURN key in the Cloudflare
# dashboard (Realtime > TURN); the API generates short-lived credentials per call.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Encryption key for patient PII and clinical data at rest (AES-256-GCM)
# Obrigatória (a API não inicia sem ela); 32 bytes em base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Google Calendar Integration (OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/google-callback

# Email (SMTP — required for forgot-password flow)
# Supports any SMTP provider (Gmail, Mailgun, Brevo, Resend, etc.)
# If not set, reset links are only logged to the API console (dev fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="psy-manager <noreply@psy-manager.com.br>"

# Sentry (error monitoring — production only)
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
