{
  "name": "psy-manager",
  "private": true,
  "version": "1.0.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,magenta \"bun run --filter @psy-manager/web dev\" \"bun run --filter @psy-manager/api dev\"",
    "dev:web": "bun run --filter @psy-manager/web dev",
    "dev:api": "bun run --filter @psy-manager/api dev",
    "build": "bun run --filter @psy-manager/web build && bun run --filter @psy-manager/api build",
    "build:web": "bun run --filter @psy-manager/web build",
    "build:api": "bun run --filter @psy-manager/api build",
    "test": "bun run --filter @psy-manager/api test && bun run --filter @psy-manager/web test",
    "test:web": "bun run --filter @psy-manager/web test",
    "test:api": "bun run --filter @psy-manager/api test",
    "test:integration": "bun run --filter @psy-manager/api test:integration",
    "test:integration:db": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:db:down": "docker compose -f docker-compose.test.yml down",
    "test:e2e": "bun run --filter @psy-manager/e2e test",
    "db:generate": "bun run --filter @psy-manager/api db:generate",
    "db:migrate": "bun run --filter @psy-manager/api db:migrate",
    "db:push": "bun run --filter @psy-manager/api db:push",
    "db:studio": "bun run --filter @psy-manager/api db:studio",
    "db:seed": "bun run --filter @psy-manager/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d db"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "shell-quote": "1.8.4"
  }
}
